{
  "name": "abacus-video-pipeline",
  "version": "0.1.0",
  "description": "Abacus curriculum teaching videos, code-generated from the app's own geometry and palette.",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "render:e01": "remotion render meet-the-abacus out/e01_meet_the_abacus/e01_meet_the_abacus_16x9.mp4",
    "render:e01:4x5": "remotion render meet-the-abacus-4x5 out/e01_meet_the_abacus/e01_meet_the_abacus_4x5.mp4",
    "render:e02": "remotion render numbers-0-to-9 out/e02_numbers_0_to_9/e02_numbers_0_to_9_16x9.mp4",
    "render:e02:4x5": "remotion render numbers-0-to-9-4x5 out/e02_numbers_0_to_9/e02_numbers_0_to_9_4x5.mp4",
    "render:all": "npm run render:e01 && npm run render:e01:4x5 && npm run render:e02 && npm run render:e02:4x5 && npm run render:e03 && npm run render:e03:4x5 && npm run render:e04 && npm run render:e04:4x5 && npm run render:e05 && npm run render:e05:4x5 && npm run render:e06 && npm run render:e06:4x5",
    "render:e03": "remotion render adding-two-numbers out/e03_adding_two_numbers/e03_adding_two_numbers_16x9.mp4",
    "render:e03:4x5": "remotion render adding-two-numbers-4x5 out/e03_adding_two_numbers/e03_adding_two_numbers_4x5.mp4",
    "render:e04": "remotion render bigger-numbers out/e04_bigger_numbers/e04_bigger_numbers_16x9.mp4",
    "render:e04:4x5": "remotion render bigger-numbers-4x5 out/e04_bigger_numbers/e04_bigger_numbers_4x5.mp4",
    "render:e05": "remotion render taking-away out/e05_taking_away/e05_taking_away_16x9.mp4",
    "render:e06": "remotion render two-rods out/e06_two_rods/e06_two_rods_16x9.mp4",
    "render:e06:4x5": "remotion render two-rods-4x5 out/e06_two_rods/e06_two_rods_4x5.mp4",
    "render:e05:4x5": "remotion render taking-away-4x5 out/e05_taking_away/e05_taking_away_4x5.mp4"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.496",
    "@remotion/paths": "^4.0.496",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "typescript": "^5.4.0"
  }
}
